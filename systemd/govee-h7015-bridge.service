[Unit]
Description=Govee H7015 MQTT Bridge
After=network-online.target mosquitto.service home-assistant.service
Wants=network-online.target

[Service]
Type=simple
# Adjust these paths to match your install location.
WorkingDirectory=/opt/govee-h7015
ExecStart=/usr/local/bin/uv run --project /opt/govee-h7015 python standalone/mqtt_bridge.py
EnvironmentFile=/opt/govee-h7015/.env
Restart=on-failure
RestartSec=10
TimeoutStartSec=30

# Baseline sandboxing — safe regardless of which user this runs as, and
# doesn't require any extra setup. BlueZ access goes over D-Bus, which
# these don't restrict.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# Uncomment and add your GOVEE_STATE_CACHE directory if you enable it —
# ProtectSystem=strict makes the filesystem read-only otherwise.
# ReadWritePaths=/var/lib/govee-h7015

# Drop privileges if you create a dedicated user.
# User=govee
# Group=govee
# SupplementaryGroups=bluetooth
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
# AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW

[Install]
WantedBy=multi-user.target
