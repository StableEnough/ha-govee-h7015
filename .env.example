# =============================================================================
# Example environment file for the Govee H7015 MQTT bridge.
# Copy to .env and edit. The bridge reads these via Pydantic Settings, which
# validates types at startup — typos cause an immediate error rather than
# silent misbehavior at runtime.
# =============================================================================

# MQTT broker
GOVEE_MQTT_HOST=127.0.0.1
GOVEE_MQTT_PORT=1883
GOVEE_MQTT_USER=
GOVEE_MQTT_PASSWORD=

# Topic prefix (change if you have multiple installations)
GOVEE_TOPIC_PREFIX=govee/h7015

# Devices: comma-separated MAC=Name pairs.
# MAC can be in AA:BB:CC:DD:EE:FF or AABBCCDDEEFF form; validated at startup.
GOVEE_DEVICES=AABBCCDDEEFF=Patio Lights,112233445566=Garden Lights

# State poll interval (seconds). Set to 0 to disable polling.
GOVEE_POLL_INTERVAL=60

# Reconnect backoff (seconds, minimum 1)
GOVEE_RECONNECT_BACKOFF=5

# State cache file path (optional — enables fast HA UI restore on restart)
# GOVEE_STATE_CACHE=/var/lib/govee-h7015/state.json

# Log level: DEBUG / INFO / WARNING / ERROR
GOVEE_LOG_LEVEL=INFO
